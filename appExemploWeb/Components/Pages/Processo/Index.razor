@page "/processos"
@using appExemploWeb.Models
@using appExemploWeb.DAO
@rendermode InteractiveServer
@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>
</div>

<div class="custom-table-card">
    <div class="table-responsive">
        @if (processos == null)
        {
            <p class="p-3 text-muted">Carregando processos...</p>
        }
        else if (!processos.Any())
        {
            <p class="p-3 text-muted">Nenhum processo encontrado.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Número</th>
                        <th>Interessado</th>
                        <th>Assunto</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var processo in processos)
                    {
                        <tr>
                            <td>@processo.Id</td>
                            <td>@processo.Numero</td>
                            <td>@processo.Interessado</td>
                            <td>@processo.Assunto</td>
                            <td>@processo.Situacao</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="#" class="btn btn-light border text-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="#" class="btn btn-light border text-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<Processo>? processos;

    protected override void OnInitialized()
    {
        // Chama o DAO para buscar os dados no banco ao inicializar a página
        processos = ProcessoDAO.Listar();
    }
}